pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import "forge-std/console2.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {KyberSwapAdapter} from "../contracts/swap/KyberSwapAdapter.sol";

contract MockStrategyCaller {
    using SafeERC20 for IERC20;

    function executeSwap(
        KyberSwapAdapter adapter,
        address router,
        address tokenIn,
        address tokenOut,
        uint256 amountIn,
        bytes calldata data,
        uint256 value
    ) external payable returns (uint256 amountOut) {
        IERC20(tokenIn).forceApprove(address(adapter), amountIn);
        amountOut = adapter.swap{value: value}(router, tokenIn, tokenOut, amountIn, address(this), data, value);
    }
}

contract KyberSwapTest is Test {
    uint256 constant MAINNET_BLOCK = 24614706;

    address public constant NUSD = address(0xE556ABa6fe6036275Ec1f87eda296BE72C811BCE);
    address public constant USDC = address(0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48);

    address public alice;
    KyberSwapAdapter public adapter;
    MockStrategyCaller public mockStrategy;

    // Pre-encoded KyberSwap calldata for 25 NUSD → USDC swap at block 24612982
    bytes public encodedData = hex"";
    address public router = address(0x6131B5fae19EA4f9D964eAc0408E4408b66337b5);

    function setUp() public {
        string memory rpcUrl = vm.envString("MAINNET_RPC_URL");
        uint256 forkId = vm.createFork(rpcUrl, MAINNET_BLOCK);
        vm.selectFork(forkId);

        alice = address(0xD6cC5015F816575C606D972C4A4aD0b3E0E50440);
        deal(NUSD, alice, 25e18);

        adapter = new KyberSwapAdapter();

        MockStrategyCaller implementation = new MockStrategyCaller();
        vm.etch(alice, address(implementation).code);
        mockStrategy = MockStrategyCaller(alice);
    }

    function testSwap() public {
        vm.startPrank(alice);
        SafeERC20.forceApprove(IERC20(NUSD), address(adapter), 25e18);
        uint256 amountOut = adapter.swap{value: 0}(router, NUSD, USDC, 25e18, alice, encodedData, 0);
        vm.stopPrank();

        assertGt(amountOut, 0, "amountOut should be > 0");
        assertGt(IERC20(USDC).balanceOf(alice), 0, "alice should have USDC");
        assertEq(IERC20(NUSD).balanceOf(alice), 0, "alice should have spent all NUSD");
        console2.log("alice USDC balance: ", IERC20(USDC).balanceOf(alice));
    }

    function testSwapFromContractCaller() public {
        assertEq(address(mockStrategy), alice, "mock contract should live at recipient address");
        console2.log("mock contract NUSD balance before swap: ", IERC20(NUSD).balanceOf(address(mockStrategy)));
        assertEq(IERC20(NUSD).balanceOf(address(mockStrategy)), 25e18, "mock should hold NUSD");

        uint256 amountOut = mockStrategy.executeSwap(
            adapter,
            router,
            NUSD,
            USDC,
            25e18,
            encodedData,
            0
        );


        assertGt(amountOut, 0, "amountOut should be > 0");
        assertEq(IERC20(NUSD).balanceOf(address(mockStrategy)), 0, "mock should have spent all NUSD");
        console2.log("mock strategy NUSD balance after swap: ", IERC20(NUSD).balanceOf(address(mockStrategy)));
        assertGt(IERC20(USDC).balanceOf(address(mockStrategy)), 0, "mock should receive USDC");

        console2.log("mock strategy USDC balance after swap: ", IERC20(USDC).balanceOf(address(mockStrategy)));
    }

    function testSwap_zeroRouterReverts() public {
        vm.startPrank(alice);
        SafeERC20.forceApprove(IERC20(NUSD), address(adapter), 25e18);
        vm.expectRevert(KyberSwapAdapter.ZeroAddress.selector);
        adapter.swap{value: 0}(address(0), NUSD, USDC, 25e18, alice, encodedData, 0);
        vm.stopPrank();
    }

    function testSwap_zeroRecipientReverts() public {
        vm.startPrank(alice);
        SafeERC20.forceApprove(IERC20(NUSD), address(adapter), 25e18);
        vm.expectRevert(KyberSwapAdapter.ZeroAddress.selector);
        adapter.swap{value: 0}(router, NUSD, USDC, 25e18, address(0), encodedData, 0);
        vm.stopPrank();
    }
}
